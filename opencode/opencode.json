{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "sobaka": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.sobaka.dev/v1",
        "apiKey": "$SOBAKA_API_KEY"
      },
      "models": {
        "sobaka-dev": {
          "id": "sobaka-dev",
          "name": "Sobaka Dev",
          "limit": {
            "context": 250000,
            "output": 64000
          }
        }
      }
    }
  }
}
